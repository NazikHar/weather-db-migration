# Основна база (етапи 1–4). Скопіюйте у .env або експортуйте змінні у shell.
DATABASE_URL=postgresql+psycopg2://weather:weather@localhost:5432/weather_pg

# Цільова база для етапу 5 (перенесення Postgres -> MySQL)
TARGET_DATABASE_URL=mysql+pymysql://weather:weather@localhost:3306/weather_mysql?charset=utf8mb4
